<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <conversionRule
            conversionWord="maskedMessage"
            converterClass="com.mealiverit.api.common.config.PiiMaskingConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss}
                [%thread]
                %-5level
                %logger{36}
                - %maskedMessage%n
            </pattern>
        </encoder>

    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
